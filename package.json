{
  "name": "@hraness/message-like-me",
  "version": "0.8.10",
  "description": "A local-first CLI and Agent Skill for studying private messaging history and drafting messages that sound like you.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/message-like-me.git"
  },
  "homepage": "https://messagelikeme.com",
  "bugs": {
    "url": "https://github.com/hraness/message-like-me/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "agent-skill",
    "beeper",
    "bun",
    "cli",
    "imessage",
    "local-first",
    "messaging",
    "messaging-style",
    "privacy",
    "wacli",
    "whatsapp"
  ],
  "bin": {
    "messagelikeme": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./message-bundle-v1": {
      "types": "./dist/message-bundle-v1.d.ts",
      "import": "./dist/message-bundle-v1.js"
    },
    "./message-bundle-v2": {
      "types": "./dist/message-bundle-v2.d.ts",
      "import": "./dist/message-bundle-v2.js"
    },
    "./agentic-messaging-v1": {
      "types": "./dist/agentic-messaging-v1.d.ts",
      "import": "./dist/agentic-messaging-v1.js"
    },
    "./ensoul-source-v1": {
      "types": "./dist/ensoul-source-v1.d.ts",
      "import": "./dist/ensoul-source-v1.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "skills",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build-dist.ts",
    "test": "bun test ./src ./scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:skill": "bun scripts/validate-skill.ts",
    "check:standalone": "bun scripts/check-standalone.ts",
    "check:dist": "bun scripts/check-dist.ts",
    "check:package": "bun scripts/package-smoke.ts",
    "check:agentrouter-package": "bun scripts/agentrouter-package-smoke.ts",
    "check": "bun run typecheck && bun run check:effect && bun run test && bun run check:skill && bun run check:standalone && bun run build && bun run check:public-graphs && bun run check:dist && bun run check:package && bun run check:agentrouter-package && bun run check:textbutler",
    "check:textbutler": "bun test packages && tsc --noEmit -p packages/agentrouter/tsconfig.json && tsc --noEmit -p packages/transport/tsconfig.json && tsc --noEmit -p packages/textbutler/tsconfig.json",
    "textbutler": "bun packages/textbutler/src/cli.ts",
    "prepack": "bun run check",
    "check:effect": "bun scripts/check-effect-architecture.ts",
    "check:public-graphs": "bun scripts/check-public-graphs.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@hraness/desktop-foundation": "https://github.com/hraness/desktop-foundation/releases/download/v0.6.0/hraness-desktop-foundation-0.6.0.tgz",
    "@anthropic-ai/sdk": "0.125.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/bun": "1.3.14",
    "effect": "3.22.1",
    "fast-check": "4.9.0",
    "sigstore": "4.1.1",
    "typescript": "6.0.3",
    "zod": "4.6.2"
  }
}
