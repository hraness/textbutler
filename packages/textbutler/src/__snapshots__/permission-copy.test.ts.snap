// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`permission copy follows the shared templates pre-prompt notices: fda interactive 1`] = `
"🔐 Textbutler needs Full Disk Access to read your Messages.
   macOS doesn't ask for this. Turn on Textbutler in System Settings › Privacy & Security › Full Disk Access. Only the chats you pick are read.
   Press Enter to open Settings · s to skip
"
`;

exports[`permission copy follows the shared templates pre-prompt notices: fda non-interactive 1`] = `
"🔐 Textbutler needs Full Disk Access to read your Messages.
   macOS doesn't ask for this. Turn on Textbutler in System Settings › Privacy & Security › Full Disk Access. Only the chats you pick are read.
"
`;

exports[`permission copy follows the shared templates pre-prompt notices: automation interactive 1`] = `
"🔐 macOS will ask to let Textbutler control Messages.
   Textbutler only sends replies in chats you turn on. Change this any time in System Settings › Privacy & Security › Automation.
   Press Enter to continue · s to skip
"
`;

exports[`permission copy follows the shared templates pre-prompt notices: automation ascii 1`] = `
"NOTE macOS will ask to let Textbutler control Messages.
   Textbutler only sends replies in chats you turn on. Change this any time in System Settings › Privacy & Security › Automation.
"
`;

exports[`permission copy follows the shared templates recovery after a denial or an unconfirmed result: full-disk-access denied interactive 1`] = `
"✗ Textbutler can't read your Messages: macOS access is off for Textbutler.
  Turn on Textbutler in System Settings › Privacy & Security › Full Disk Access.
→ textbutler doctor · press o to open Settings
"
`;

exports[`permission copy follows the shared templates recovery after a denial or an unconfirmed result: full-disk-access denied ascii 1`] = `
