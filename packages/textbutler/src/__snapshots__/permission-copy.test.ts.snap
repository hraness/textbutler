exports[`doctor's macOS access step walks from installing the app to a finished setup: access steps 1`] = `
[
  {
    "command": "textbutler help permissions",
    "detail": "iMessage works through the Textbutler app on this Mac. Install it, then turn on Textbutler in System Settings › Privacy & Security › Full Disk Access.",
    "id": "macos-access",
    "settingsUrl": "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles",
    "status": "action-needed",
    "title": "macOS access for iMessage",
  },
  {
    "command": "bun run textbutler:app imessage-setup --data-dir <data-dir>",
    "detail": "Turn on Textbutler in System Settings › Privacy & Security › Full Disk Access, then run app setup. macOS will ask to let Textbutler control Messages.",
    "id": "macos-access",
    "settingsUrl": "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles",
    "status": "action-needed",
    "title": "macOS access for iMessage",
  },
  {
    "command": "bun run textbutler:app imessage-setup --data-dir <data-dir>",
    "detail": "Textbutler can't control Messages: macOS access is off for Textbutler. Turn on Textbutler in System Settings › Privacy & Security › Automation. macOS won't ask again, so run app setup again after you turn it on.",
    "id": "macos-access",
    "settingsUrl": "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation",
    "status": "blocked",
    "title": "macOS access for iMessage",
  },
  {
    "command": "bun run textbutler:app imessage-setup --data-dir <data-dir>",
    "detail": "Textbutler couldn't control Messages. macOS may be blocking Textbutler. Check System Settings › Privacy & Security › Automation. Then run app setup again.",
    "id": "macos-access",
    "settingsUrl": "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation",
    "status": "blocked",
    "title": "macOS access for iMessage",
  },
  {
    "command": "bun run textbutler:app imessage-setup --data-dir <data-dir>",
    "detail": "App setup stopped before it finished. Run it again.",
    "id": "macos-access",
    "status": "action-needed",
    "title": "macOS access for iMessage",
  },
  {
    "detail": "Textbutler can control Messages. If iMessage chats stop loading, turn on Textbutler in System Settings › Privacy & Security › Full Disk Access.",
    "id": "macos-access",
    "status": "done",
    "title": "macOS access for iMessage",
  },
]
`;
