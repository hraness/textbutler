{
  "name": "message-like-me-site",
  "version": "0.8.24",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:browser": "bun --no-env-file scripts/check-browser.mjs",
    "check:production-image-fixture": "bun --no-env-file scripts/production-image-settlement.fixture.mjs",
    "check:theme": "bun scripts/check-paper-theme.mjs",
    "sync:readme": "bun scripts/sync-readme.ts",
    "test": "bun run check:theme && bun test scripts",
    "dev": "bun run sync:readme && bun run build:theme && next dev --webpack",
    "build": "bun run build:theme && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "bun run sync:readme && bun run test && bun run lint && bun run typecheck && bun run build",
    "build:theme": "bun scripts/build-theme-bootstrap.ts",
    "diagrams": "bun scripts/render-diagrams.ts",
    "stills": "bun scripts/render-stills.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.41.0",
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.11/hraness-posthog-0.3.11.tgz",
    "@hraness/site-footer": "https://github.com/hraness/site-footer/releases/download/v0.20.6/hraness-site-footer-0.20.6.tgz",
    "@hraness/textmockups": "https://github.com/hraness/textmockups/releases/download/v0.4.0/hraness-textmockups-0.4.0.tgz",
    "@hraness/ui": "github:hraness/ui#v0.5.19",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@stylexjs/babel-plugin": "0.19.1",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "lightningcss": "1.33.0",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2"
  },
  "type": "module",
  "overrides": {
    "fast-glob": "npm:tinyglobby@0.2.17",
    "source-map-js": "1.2.2"
  }
}
